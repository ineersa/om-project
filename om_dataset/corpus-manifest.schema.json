{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private OM source corpus manifest, not a training invocation release",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_kind", "completed_at", "training_ready", "redacted", "model_calls", "target", "pi_seq_mapping", "source_visibility", "split_status", "artifacts", "report_ref"],
  "properties": {
    "schema_version": {"const": "om-corpus/1"},
    "dataset_kind": {"const": "private_source_corpus"},
    "completed_at": {"type": "string", "format": "date-time"},
    "training_ready": {"const": false},
    "redacted": {"const": false},
    "model_calls": {"const": 0},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "revision"],
      "properties": {
        "runtime": {"const": "hatfield"},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "pi_seq_mapping": {"type": "string", "minLength": 1},
    "source_visibility": {"type": "string", "minLength": 1},
    "split_status": {"const": "unassigned"},
    "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "report_ref": {"$ref": "#/$defs/artifact"}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
